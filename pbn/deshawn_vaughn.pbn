META style=SWARMER element=GALE house=none slot=R1 arc=3 no_idle_weight=true
IDLE: perpetual_advance
STRING S1 "Merge": TELL(gum_stop, 450ms) -> RUSH(0.6m) -> L_HOOK -> R_HOOK
STRING S2 "Interchange": TELL(gum_stop, 450ms) -> LATERAL_ARC -> JAB -> LT_L_HOOK
